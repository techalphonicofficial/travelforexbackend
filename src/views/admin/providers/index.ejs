<style>
  .provider-shell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .provider-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .provider-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
  }

  .provider-muted {
    color: #64748b;
    font-size: .88rem;
    margin: .25rem 0 0;
  }

  .provider-add-btn {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    height: 42px;
    border: 0;
    border-radius: 8px;
    background: #4f46e5;
    color: #fff;
    padding: 0 1rem;
    font-size: .84rem;
    font-weight: 800;
    cursor: pointer;
  }

  .provider-panel {
    background: #fff;
    border: 1px solid #e0e7ff;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(79,70,229,.06);
    overflow: hidden;
  }

  .provider-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .provider-table {
    width: 100%;
    min-width: 1150px;
    border-collapse: collapse;
  }

  .provider-table th {
    background: #f8fafc;
    color: #475569;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    padding: .85rem 1rem;
    border-bottom: 1px solid #e0e7ff;
    text-align: left;
  }

  .provider-table td {
    padding: .9rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    vertical-align: middle;
    color: #334155;
    font-size: .86rem;
  }

  .provider-table tr:last-child td {
    border-bottom: 0;
  }

  .provider-main {
    font-weight: 800;
    color: #111827;
  }

  .provider-sub {
    font-size: .76rem;
    color: #64748b;
    margin-top: .25rem;
    word-break: break-all;
  }

  .provider-env {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: .25rem .65rem;
    font-size: .73rem;
    font-weight: 800;
  }

  .provider-env-test {
    background: #fef3c7;
    color: #92400e;
  }

  .provider-env-production {
    background: #dcfce7;
    color: #166534;
  }

  .provider-key {
    font-family: monospace;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: .35rem .5rem;
    font-size: .76rem;
  }

  .provider-actions {
    display: flex;
    justify-content: flex-end;
    gap: .4rem;
    flex-wrap: wrap;
  }

  .provider-action {
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: .42rem .72rem;
    font-size: .78rem;
    font-weight: 800;
    cursor: pointer;
    background: #fff;
  }

  .provider-edit {
    color: #4338ca;
    background: #eef2ff;
    border-color: #c7d2fe;
  }

  .provider-delete {
    color: #b91c1c;
    background: #fef2f2;
    border-color: #fecaca;
  }

  .provider-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: #64748b;
  }

  .provider-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(15, 23, 42, .45);
  }

  .provider-modal.show {
    display: flex;
  }

  .provider-modal-card {
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(15,23,42,.2);
  }

  .provider-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid #eef2f7;
  }

  .provider-modal-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: #111827;
  }

  .provider-close {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: #f1f5f9;
    color: #475569;
    cursor: pointer;
    font-size: 1.1rem;
  }

  .provider-form {
    padding: 1.25rem;
  }

  .provider-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .provider-field {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }

  .provider-field.full {
    grid-column: 1 / -1;
  }

  .provider-field label {
    font-size: .8rem;
    font-weight: 800;
    color: #475569;
  }

  .provider-field input,
  .provider-field select {
    width: 100%;
    height: 42px;
    box-sizing: border-box;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: 0 .8rem;
    color: #1f2937;
    background: #fff;
    outline: none;
  }

  .provider-field input:focus,
  .provider-field select:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.1);
  }

  .provider-help {
    color: #94a3b8;
    font-size: .72rem;
  }

  .provider-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: .6rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid #eef2f7;
  }

  .provider-cancel {
    height: 42px;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    background: #f8fafc;
    color: #475569;
    padding: 0 1rem;
    font-weight: 800;
    cursor: pointer;
  }

  .provider-save {
    height: 42px;
    border: 0;
    border-radius: 8px;
    background: #4f46e5;
    color: #fff;
    padding: 0 1.1rem;
    font-weight: 800;
    cursor: pointer;
  }

  @media (max-width: 700px) {
    .provider-form-grid {
      grid-template-columns: 1fr;
    }

    .provider-field.full {
      grid-column: auto;
    }
  }
</style>

<section class="provider-shell">

  <div class="provider-header">

    <div>
      <h1 class="provider-title">
        API Providers
      </h1>

      <p class="provider-muted">
        Manage API credentials, environments and endpoints for external service providers.
      </p>
    </div>

    <button
      type="button"
      class="provider-add-btn"
      onclick="openProviderModal('create')">

      <i class="bi bi-plus-lg"></i>
      Add Provider

    </button>

  </div>

  <% if (success) { %>

    <div
      class="alert alert-success border-0"
      style="border-radius:8px;">

      <%= success %>

    </div>

  <% } %>

  <% if (error) { %>

    <div
      class="alert alert-danger border-0"
      style="border-radius:8px;">

      <%= error %>

    </div>

  <% } %>

  <div class="provider-panel">

    <div class="provider-table-wrap">

      <table class="provider-table">

        <thead>

          <tr>

            <th>Provider</th>

            <th>Environment</th>

            <th>API Key</th>

            <th>Hotel URL</th>

            <th>Flight URL</th>

            <th>Actions</th>

          </tr>

        </thead>

        <tbody>

          <% if (providers && providers.length) { %>

            <% providers.forEach(provider => { %>

              <tr>

                <td>

                  <div class="provider-main">
                    <%= provider.provider_name %>
                  </div>

                  <div class="provider-sub">
                    ID: <%= provider.id %>
                  </div>

                </td>

                <td>

                  <span
                    class="provider-env <%= provider.environment === 'PRODUCTION'
                      ? 'provider-env-production'
                      : 'provider-env-test' %>">

                    <%= provider.environment %>

                  </span>

                </td>

                <td>

                  <span class="provider-key">

                    <%= provider.api_key
                      ? '••••••••••••' + String(provider.api_key).slice(-4)
                      : 'Not configured' %>

                  </span>

                </td>

                <td>

                  <div class="provider-sub">
                    <%= provider.hotel_url || 'Not configured' %>
                  </div>

                </td>

                <td>

                  <div class="provider-sub">
                    <%= provider.flight_url || 'Not configured' %>
                  </div>

                </td>

                <td>

                  <div class="provider-actions">

                    <button
                      type="button"
                      class="provider-action provider-edit"
                      onclick='editProvider(<%- JSON.stringify(provider) %>)'>

                      <i class="bi bi-pencil"></i>
                      Edit

                    </button>

                    <form
                      method="POST"
                      action="/admin/providers/<%= provider.id %>/delete"
                      onsubmit="return confirm('Are you sure you want to delete this provider configuration?');">

                      <button
                        type="submit"
                        class="provider-action provider-delete">

                        <i class="bi bi-trash"></i>
                        Delete

                      </button>

                    </form>

                  </div>

                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td colspan="6">

                <div class="provider-empty">

                  <i class="bi bi-plug fs-1 d-block mb-2 text-light"></i>

                  <div class="fw-bold">
                    No API providers configured.
                  </div>

                  <div class="mt-1">
                    Add your first provider configuration to get started.
                  </div>

                </div>

              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

</section>


<!-- Provider Modal -->

<div
  id="providerModal"
  class="provider-modal">

  <div class="provider-modal-card">

    <div class="provider-modal-header">

      <h2
        id="providerModalTitle"
        class="provider-modal-title">

        Add API Provider

      </h2>

      <button
        type="button"
        class="provider-close"
        onclick="closeProviderModal()">

        ×

      </button>

    </div>

    <form
      id="providerForm"
      class="provider-form"
      method="POST"
      action="/admin/providers">

      <div class="provider-form-grid">

        <div class="provider-field full">

          <label for="provider_name">
            Provider Name
          </label>

          <input
            type="text"
            id="provider_name"
            name="provider_name"
            placeholder="e.g. TripJack"
            required>

        </div>

        <div class="provider-field full">

          <label for="api_key">
            API Key
          </label>

          <input
            type="text"
            id="api_key"
            name="api_key"
            placeholder="Enter provider API key">

          <span
            id="apiKeyHelp"
            class="provider-help">

            API key is required when creating a provider.

          </span>

        </div>

        <div class="provider-field">

          <label for="hotel_url">
            Hotel URL
          </label>

          <input
            type="url"
            id="hotel_url"
            name="hotel_url"
            placeholder="https://hotel-api.example.com"
            required>

        </div>

        <div class="provider-field">

          <label for="flight_url">
            Flight URL
          </label>

          <input
            type="url"
            id="flight_url"
            name="flight_url"
            placeholder="https://flight-api.example.com"
            required>

        </div>

        <div class="provider-field">

          <label for="environment">
            Environment
          </label>

          <select
            id="environment"
            name="environment"
            required>

            <option value="TEST">
              TEST
            </option>

            <option value="PRODUCTION">
              PRODUCTION
            </option>

          </select>

        </div>

      </div>

      <div class="provider-modal-footer">

        <button
          type="button"
          class="provider-cancel"
          onclick="closeProviderModal()">

          Cancel

        </button>

        <button
          type="submit"
          class="provider-save">

          Save Provider

        </button>

      </div>

    </form>

  </div>

</div>


<script>

  const providerModal =
    document.getElementById('providerModal');

  const providerForm =
    document.getElementById('providerForm');

  const providerModalTitle =
    document.getElementById('providerModalTitle');

  const apiKeyInput =
    document.getElementById('api_key');

  const apiKeyHelp =
    document.getElementById('apiKeyHelp');


  function openProviderModal(mode) {

    providerModal.classList.add('show');

    if (mode === 'create') {

      providerModalTitle.textContent =
        'Add API Provider';

      providerForm.action =
        '/admin/providers';

      providerForm.reset();

      apiKeyInput.required = true;

      apiKeyHelp.textContent =
        'API key is required when creating a provider.';

    }

  }


  function editProvider(provider) {

    providerModal.classList.add('show');

    providerModalTitle.textContent =
      'Edit API Provider';

    providerForm.action =
      '/admin/providers/' + provider.id + '/update';

    document.getElementById('provider_name').value =
      provider.provider_name || '';

    document.getElementById('hotel_url').value =
      provider.hotel_url || '';

    document.getElementById('flight_url').value =
      provider.flight_url || '';

    document.getElementById('environment').value =
      provider.environment || 'TEST';

    /*
     * API key is intentionally not loaded into the form.
     * Leave blank to keep existing key.
     */

    apiKeyInput.value = '';

    apiKeyInput.required = false;

    apiKeyHelp.textContent =
      'Leave blank to keep the existing API key.';

  }


  function closeProviderModal() {

    providerModal.classList.remove('show');

  }


  providerModal.addEventListener(
    'click',
    function(event) {

      if (event.target === providerModal) {
        closeProviderModal();
      }

    }
  );


  document.addEventListener(
    'keydown',
    function(event) {

      if (event.key === 'Escape') {
        closeProviderModal();
      }

    }
  );

</script>