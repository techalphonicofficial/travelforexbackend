                    ${renderOverview(b, payload.customer)}
                </div>
                <div class="tab-pane fade tab-body" id="tabTrip">${type === 'HOTEL' ? renderHotel(b) : renderFlight(b)}</div>
                <div class="tab-pane fade tab-body" id="tabPax">${renderTravellers(b)}</div>
                <div class="tab-pane fade tab-body" id="tabPay">${renderPayments(b, payload.payments || [])}</div>
                <div class="tab-pane fade tab-body" id="tabSupplier">${renderSupplier(b)}</div>
            </div>
        `;
        bindRefundForm();
    }

    async function openDetails(id) {
        openBookingId = id;
        $('modalReference').textContent = '';
        $('bookingDetailsBody').innerHTML = '<div class="state-box"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading booking…</div>';
        modal.show();
        try {
            const result = await api(`/${encodeURIComponent(id)}/details`);
            if (openBookingId !== id) return;
            renderDetails(result.data);
        } catch (error) {
            $('bookingDetailsBody').innerHTML = `<div class="state-box"><i class="bi bi-exclamation-circle text-danger"></i>${escapeHtml(error.message)}</div>`;
        }
    }

    function bindRefundForm() {
        const form = $('refundForm');
        if (!form) return;

        form.method.addEventListener('change', () => {
            $('manualRefRow').classList.toggle('d-none', form.method.value !== 'MANUAL');
        });

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const amount = Number(form.amount.value);
            const method = form.method.value;
            const label = method === 'GATEWAY' ? 'to the customer\'s original payment method' : 'as a manual refund';
            if (!window.confirm(`Refund ${money(amount)} ${label}? This cannot be undone.`)) return;

            $('refundSubmit').disabled = true;
            $('refundMsg').className = 'small text-secondary';
            $('refundMsg').textContent = 'Processing…';

            try {
                const result = await api(`/${encodeURIComponent(openBookingId)}/refund`, {
                    method: 'POST',
                    body: JSON.stringify({
                        amount,
                        method,
                        reason: form.reason.value,
                        reference: form.reference?.value || '',
                        supplierCancelled: Boolean(form.supplierCancelled?.checked)
                    })
                });
                $('refundMsg').className = 'small text-success';
                $('refundMsg').textContent = result.message || 'Refund done';
                await openDetails(openBookingId);
                loadBookings(currentPage);
            } catch (error) {
                $('refundMsg').className = 'small text-danger';
                $('refundMsg').textContent = error.message;
                $('refundSubmit').disabled = false;
            }
        });
    }

    /* ---------------- events ---------------- */

    $('bookingTableBody').addEventListener('click', event => {
        const btn = event.target.closest('[data-view]');
        if (btn) openDetails(bookings[Number(btn.dataset.view)]?.id);
    });

    $('refreshStatusBtn').addEventListener('click', async () => {
        if (!openBookingId) return;
        const btn = $('refreshStatusBtn');
        btn.disabled = true;
        try {
            await api(`/${encodeURIComponent(openBookingId)}/refresh`, { method: 'POST', body: '{}' });
            await openDetails(openBookingId);
            loadBookings(currentPage);
        } catch (error) {
            window.alert(error.message);
        } finally {
            btn.disabled = false;
        }
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            if (btn.dataset.type === currentType) return;
            currentType = btn.dataset.type;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.type === currentType));
            loadBookings(1);
        });
    });

    $('statusFilter').addEventListener('change', () => {
        currentStatus = $('statusFilter').value;
        loadBookings(1);
    });

    $('actionCard').addEventListener('click', () => {
        $('statusFilter').value = 'ACTION';
        currentStatus = 'ACTION';
        loadBookings(1);
    });

    $('searchInput').addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            currentQuery = $('searchInput').value.trim();
            loadBookings(1);
        }, 350);
    });

    $('refreshBtn').addEventListener('click', () => loadBookings(currentPage));
    $('retryBtn').addEventListener('click', () => loadBookings(currentPage));

    loadBookings(1);
})();
</script>
</body>
</html>
