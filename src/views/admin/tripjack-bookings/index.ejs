    function renderPagination(info) {
        const page = Number(info.currentPage) || currentPage;
        const limit = Number(info.limit) || PAGE_LIMIT;
        const total = Number(info.totalRecords) || 0;
        const start = total ? ((page - 1) * limit + 1) : 0;
        const end = Math.min(page * limit, total);

        $('paginationInfo').textContent = `Showing ${start}–${end} of ${total} bookings`;
        if (totalPages <= 1) return;

        const addPage = (label, target, disabled = false, active = false) => {
            const li = document.createElement('li');
            li.className = `page-item${disabled ? ' disabled' : ''}${active ? ' active' : ''}`;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'page-link';
            btn.textContent = label;
            btn.disabled = disabled;
            btn.addEventListener('click', () => loadBookings(target));
            li.appendChild(btn);
            $('pagination').appendChild(li);
        };
        const dots = () => {
            const li = document.createElement('li');
            li.className = 'page-item disabled';
            li.innerHTML = '<span class="page-link">…</span>';
            $('pagination').appendChild(li);
        };

        addPage('‹', page - 1, page <= 1);
        const first = Math.max(1, page - 2);
        const last = Math.min(totalPages, page + 2);
        if (first > 1) { addPage('1', 1, false, page === 1); if (first > 2) dots(); }
        for (let p = first; p <= last; p++) addPage(String(p), p, false, p === page);
        if (last < totalPages) { if (last < totalPages - 1) dots(); addPage(String(totalPages), totalPages, false, page === totalPages); }
        addPage('›', page + 1, page >= totalPages);
    }

    /* ---------------- details ---------------- */

    function renderOverview(b, customer) {
        const data = b.booking_data || {};
        const contact = data.contact || data.primaryGuest || {};
        const refund = b.refundSummary || {};
        const alerts = [];

        if (data.refundRequired && refund.refundable > 0) {
            alerts.push(`<div class="alert-box red"><b>Refund required.</b> Payment was received but the booking was not confirmed by the supplier. Refundable: ${money(refund.refundable)}.</div>`);
        }
        if (data.needsManualReview) {
            alerts.push('<div class="alert-box amber"><b>Needs manual review.</b> The supplier has not confirmed this booking for a long time. Check it in the supplier panel.</div>');
        }
        if (data.bookingError?.message) {
            alerts.push(`<div class="alert-box red"><b>Booking error:</b> ${escapeHtml(data.bookingError.message)}</div>`);
        }
        if (data.validationError?.message) {
            alerts.push(`<div class="alert-box amber"><b>Fare check error:</b> ${escapeHtml(data.validationError.message)}</div>`);
        }
        if (data.paymentFailure) {
            alerts.push(`<div class="alert-box amber"><b>Payment failed</b> ${escapeHtml(data.paymentFailure.message || '')} (code ${escapeHtml(data.paymentFailure.responseCode || '—')})</div>`);
        }
        if (normalized(b.status) === 'BOOKED') {
            const pnr = airlinePnr(b);
            if (pnr || normalized(b.booking_type) !== 'FLIGHT') {
                alerts.push(`<div class="alert-box green"><b>Confirmed.</b>${pnr ? ` PNR ${escapeHtml(pnr)}` : ''}${data.confirmedAt ? ` • ${date(data.confirmedAt, true)}` : ''}</div>`);
            } else {
                alerts.push(`<div class="alert-box amber"><b>Marked booked, but no airline PNR has been received.</b> Supplier booking ID ${escapeHtml(b.provider_booking_id || '—')}. Verify the ticket status in the supplier panel.</div>`);
            }

            // PNR / e-ticket numbers arriving after confirmation
            const sync = data.ticketSync;
            if (sync?.gaveUp) {
                alerts.push(`<div class="alert-box red"><b>Ticket details still missing</b> 24 hours after departure. Automatic checks stopped — please check with the supplier.${sync.lastError ? ` Last error: ${escapeHtml(sync.lastError)}` : ''}</div>`);
            } else if (sync && !sync.complete) {
                alerts.push(`<div class="alert-box amber"><b>Waiting for ${sync.hasPnr ? 'e-ticket numbers' : 'PNR'}.</b> Checked ${escapeHtml(sync.checks || 0)} time(s), last ${date(sync.lastCheckAt, true)}. Checked every 5 minutes for 2 hours, then hourly until departure. Use “Refresh status from supplier” to check now.${sync.lastError ? ` Last error: ${escapeHtml(sync.lastError)}` : ''}</div>`);
            } else if (sync?.complete && sync.lcc && !sync.hasTickets) {
                alerts.push(`<div class="alert-box green"><b>Low-cost airline:</b> no separate e-ticket number; the PNR is the ticket reference.</div>`);
            }
            if (data.needsManualReview && data.tripJackOrderStatus && data.tripJackOrderStatus !== 'SUCCESS') {
                alerts.push(`<div class="alert-box red"><b>Supplier now reports this order as ${escapeHtml(data.tripJackOrderStatus)}.</b> Please verify with the supplier.</div>`);
            }
        }

        return `
            ${alerts.join('')}
            ${section('Booking', 'bi-receipt', `<div class="detail-grid">
                ${item('Booking reference', b.booking_reference)}
                ${item('Booking type', b.booking_type)}
                ${item('Booking status', statusBadge(b.status), true)}
                ${item('Payment status', statusBadge(b.payment_status), true)}
                ${item('Amount charged', money(b.amount, b.currency))}
                ${item('Refunded', money(refund.refunded || 0))}
                ${item('Created', date(b.created_at, true))}
                ${item('Last updated', date(b.updated_at, true))}
                ${item('Airline PNR', airlinePnr(b) || (normalized(b.booking_type) === 'FLIGHT' ? 'Not received' : null))}
                ${item('Supplier booking ID', b.provider_booking_id)}
            </div>`)}
            ${section('Booked by (account)', 'bi-person-badge', customer ? `<div class="detail-grid">
                ${item('Name', customer.name)}
                ${item('Email', customer.email)}
                ${item('Phone', customer.phone)}
                ${item('City', customer.city)}
                ${item('Account type', customer.type)}
                ${item('Account status', statusBadge(customer.active ? 'ACTIVE' : 'INACTIVE'), true)}
                ${item('Member since', date(customer.memberSince))}
                ${item('Bookings by this account', `${customer.bookings ?? 0} total • ${customer.confirmedBookings ?? 0} confirmed`)}
                ${item('User ID', b.user_id)}
            </div>` : `<div class="text-muted small">${b.user_id ? `Account ${escapeHtml(b.user_id)} was not found.` : 'This booking is not linked to an account.'}</div>`)}
            ${section('Booking contact', 'bi-person', `<div class="detail-grid">
                ${item('Email', contact.email)}
                ${item('Mobile', [contact.countryCode, contact.mobile].filter(Boolean).join(' '))}
                ${item('Name', [contact.title, contact.firstName, contact.lastName].filter(Boolean).join(' ') || null)}
            </div>`)}
            ${data.emergencyContact ? section('Emergency contact', 'bi-telephone', `<div class="detail-grid">
                ${item('Name', data.emergencyContact.name)}
                ${item('Mobile', data.emergencyContact.mobile)}
            </div>`) : ''}
            ${data.gstInfo ? section('GST details', 'bi-building-check', `<div class="detail-grid">
                ${item('GSTIN', data.gstInfo.gstNumber)}
                ${item('Company', data.gstInfo.registeredName)}
                ${item('Email', data.gstInfo.email)}
                ${item('Phone', data.gstInfo.mobile)}
                ${item('Address', data.gstInfo.address)}
            </div>`) : ''}
        `;
    }

    function renderFlight(b) {
        const data = b.booking_data || {};
        const segs = flightSegments(b);
        const review = data.review || {};
        const fare = review.totalPriceInfo?.totalFareDetail?.fC || {};
        const taxes = review.totalPriceInfo?.totalFareDetail?.afC?.TAF || {};
        const pnrDetails = data.pnrDetails || {};

        const segHtml = segs.map((s, i) => {
            const next = segs[i + 1];
            const layover = next && !next.isRs !== !s.isRs ? '' : next ? `<div class="layover">Layover at ${escapeHtml(s.aa?.city || s.aa?.code)} • ${escapeHtml(Math.round((new Date(next.dt) - new Date(s.at)) / 60000))} min</div>` : '';
            const sector = `${s.da?.code}-${s.aa?.code}`;
            return `<div class="card-lite"><div class="seg-row">
                <div><strong>${escapeHtml(s.fD?.aI?.name || '')}</strong><div class="booking-sub">${escapeHtml(`${s.fD?.aI?.code || ''}-${s.fD?.fN || ''}`)} • ${escapeHtml(s.fD?.eT ? `Aircraft ${s.fD.eT}` : '')}</div></div>
                <div><strong>${time(s.dt)} ${escapeHtml(s.da?.code)}</strong><div class="booking-sub">${date(s.dt)} • ${escapeHtml(s.da?.terminal || '')}</div></div>
                <div class="text-center booking-sub">${escapeHtml(s.duration ? `${Math.floor(s.duration / 60)}h ${s.duration % 60}m` : '')}</div>
                <div><strong>${time(s.at)} ${escapeHtml(s.aa?.code)}</strong><div class="booking-sub">${date(s.at)} • ${escapeHtml(s.aa?.terminal || '')}</div></div>
            </div>${pnrDetails[sector] ? `<div class="mt-2"><span class="badge-custom success">PNR ${escapeHtml(pnrDetails[sector])}</span></div>` : ''}</div>${layover}`;
        }).join('');

        const addOns = Array.isArray(data.addOns) ? data.addOns : [];
        const passengers = data.passengers || [];
        const addOnHtml = addOns.length ? `<div class="table-wrap"><table class="mini-table">
            <thead><tr><th>Traveller</th><th>Type</th><th>Flight</th><th>Item</th><th>Price</th></tr></thead>
            <tbody>${addOns.map(a => {
                const p = passengers[a.passengerIndex] || {};
                // add-on keys are review segment ids (booking-details uses its own ids)
                const s = [...(data.review?.tripInfos || []).flatMap(t => t.sI || []), ...segs].find(x => String(x.id) === String(a.key));
                return `<tr><td>${escapeHtml(`${p.firstName || ''} ${p.lastName || ''}`)}</td><td>${escapeHtml(a.type)}</td><td>${escapeHtml(s ? `${s.da?.code}-${s.aa?.code}` : a.key)}</td><td>${escapeHtml(a.desc || a.code)}</td><td>${money(a.amount)}</td></tr>`;
            }).join('')}</tbody></table></div>` : '<div class="small text-secondary">No seats, meals or extra baggage.</div>';

        const breakup = data.amountBreakup || {};
        return `
            ${section('Itinerary', 'bi-airplane', segHtml || '<div class="small text-secondary">Itinerary not available.</div>')}
            ${section('Fare', 'bi-cash-stack', `<div class="detail-grid">
                ${item('Base fare', money(fare.BF))}
                ${item('Taxes & fees', money(fare.TAF))}
                ${item('Flight fare (TF)', money(breakup.fare ?? fare.TF))}
                ${item('Add-ons', money(breakup.addOns ?? 0))}
                ${item('Total charged', money(breakup.total ?? b.amount))}
                ${item('Tax breakup', Object.entries(taxes).map(([k, v]) => `${k}: ${v}`).join(', '))}
            </div>`)}
            ${section('Seats, meals & baggage', 'bi-bag', addOnHtml)}
        `;
    }

    function renderHotel(b) {
