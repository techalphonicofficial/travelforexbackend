
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TripJack Bookings</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #2563eb;
            --border: #e5e7eb;
            --muted: #64748b;
            --bg: #f8fafc;
        }

        body {
            background: var(--bg);
            color: #111827;
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: 14px;
        }

        .page-container { padding: 26px; max-width: 1600px; margin: auto; }
        .page-title { font-size: 24px; font-weight: 750; }
        .subtitle { color: var(--muted); font-size: 13px; }

        .total-card, .content-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .total-card { padding: 16px 20px; min-width: 200px; }
        .total-card.action { cursor: pointer; }
        .total-card.action:hover { border-color: #fca5a5; }
        .total-icon {
            width: 42px; height: 42px; border-radius: 10px;
            background: #eff6ff; color: var(--primary);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .total-card.action .total-icon { background: #fef2f2; color: #dc2626; }
        .total-label { font-size: 12px; color: var(--muted); }
        .total-value { font-size: 26px; font-weight: 750; }

        .toolbar {
            padding: 14px 20px; display: flex;
            justify-content: space-between; align-items: center;
            gap: 12px; flex-wrap: wrap; border-bottom: 1px solid var(--border);
        }
        .toolbar-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .toolbar-right .form-select, .toolbar-right .form-control { font-size: 13px; height: 36px; }
        .toolbar-right .form-control { width: 260px; }

        .filter-group { display: flex; gap: 6px; flex-wrap: wrap; }
        .filter-btn {
            border: 1px solid transparent; background: transparent;
            border-radius: 8px; padding: 8px 14px;
            color: var(--muted); font-size: 13px; font-weight: 650;
        }
        .filter-btn:hover { background: #f1f5f9; }
        .filter-btn.active { color: var(--primary); background: #eff6ff; border-color: #bfdbfe; }

        .refresh-btn, .view-btn {
            background: #fff; border: 1px solid #cbd5e1;
            border-radius: 7px; padding: 7px 12px;
            font-size: 12px; font-weight: 650; color: #334155;
        }
        .refresh-btn:hover, .view-btn:hover { border-color: var(--primary); color: var(--primary); background: #eff6ff; }

        .booking-table { min-width: 1100px; margin: 0; }
        .booking-table thead th {
            background: #f8fafc; color: #64748b;
            font-size: 11px; font-weight: 750;
            letter-spacing: .4px; text-transform: uppercase;
            padding: 13px 14px; white-space: nowrap;
            border-bottom: 1px solid var(--border);
        }
        .booking-table tbody td { padding: 13px 14px; vertical-align: middle; border-color: #f1f5f9; }
        .booking-table tbody tr:hover { background: #fafcff; }
        .booking-ref { font-weight: 700; color: #1e293b; }
        .booking-date, .booking-sub { color: var(--muted); font-size: 11px; margin-top: 3px; }
        .booking-main { font-weight: 650; color: #1e293b; }

        .badge-custom {
            display: inline-flex; align-items: center; gap: 5px;
            border-radius: 6px; padding: 4px 8px;
            font-size: 11px; font-weight: 750; white-space: nowrap;
        }
        .type-hotel { background: #eff6ff; color: #1d4ed8; }
        .type-flight { background: #f5f3ff; color: #6d28d9; }
        .type-other { background: #f1f5f9; color: #475569; }
        .success { background: #dcfce7; color: #166534; }
        .warning { background: #fef3c7; color: #92400e; }
        .danger { background: #fee2e2; color: #991b1b; }
        .neutral { background: #f1f5f9; color: #475569; }
        .info { background: #e0f2fe; color: #075985; }
        .amount { font-weight: 750; white-space: nowrap; }
        .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; }

        .pagination-area {
            padding: 14px 20px; display: flex;
            justify-content: space-between; align-items: center;
            flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--border);
        }
        .pagination-info { font-size: 12px; color: var(--muted); }
        .page-link { font-size: 12px; color: #475569; }
        .page-item.active .page-link { background: var(--primary); border-color: var(--primary); }

        .state-box { text-align: center; padding: 55px 20px; color: var(--muted); }
        .state-box i { display: block; font-size: 35px; margin-bottom: 10px; }

        /* Details modal */
        .modal-content { border: 0; border-radius: 14px; overflow: hidden; }
        .modal-header { padding: 18px 22px; border-bottom: 1px solid var(--border); }
        .modal-title { font-weight: 750; font-size: 18px; }
        .modal-body { padding: 0; max-height: 78vh; overflow-y: auto; }
        .modal-footer { border-top: 1px solid var(--border); padding: 12px 22px; }

        .detail-tabs { position: sticky; top: 0; z-index: 2; background: #fff; padding: 0 22px; border-bottom: 1px solid var(--border); }
        .detail-tabs .nav-link { color: var(--muted); font-weight: 650; font-size: 13px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; padding: 12px 14px; }
        .detail-tabs .nav-link.active { color: var(--primary); border-bottom-color: var(--primary); background: none; }
        .tab-body { padding: 20px 22px; }

        .detail-hero {
            display: flex; justify-content: space-between; align-items: flex-start;
            gap: 14px; flex-wrap: wrap;
            background: linear-gradient(135deg, #eff6ff, #f8fafc);
            border: 1px solid #dbeafe; border-radius: 12px;
            padding: 16px; margin-bottom: 16px;
        }
        .detail-hero-title { font-size: 17px; font-weight: 750; }
        .detail-hero-subtitle { color: var(--muted); font-size: 12px; margin-top: 4px; }

        .detail-section { margin-bottom: 20px; }
        .section-heading { font-size: 12px; font-weight: 800; letter-spacing: .4px; text-transform: uppercase; color: #334155; margin-bottom: 10px; display: flex; align-items: center; gap: 7px; }
        .detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 16px; }
        .detail-item { min-width: 0; }
        .detail-label { font-size: 11px; color: var(--muted); }
        .detail-value { font-weight: 600; word-break: break-word; }

        .alert-box { border-radius: 10px; padding: 11px 14px; font-size: 13px; margin-bottom: 12px; }
        .alert-box.red { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
        .alert-box.amber { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
        .alert-box.green { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }

        .card-lite { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; background: #fff; }
        .seg-row { display: grid; grid-template-columns: 1.3fr 1fr 0.6fr 1fr; gap: 10px; align-items: center; }
        .seg-row strong { font-size: 15px; }
        .layover { text-align: center; font-size: 12px; color: #92400e; background: #fffbeb; border: 1px dashed #fcd34d; border-radius: 8px; padding: 5px; margin: 6px 0; }

        .mini-table { width: 100%; font-size: 12.5px; border-collapse: collapse; }
        .mini-table th { background: #f8fafc; color: var(--muted); font-size: 11px; font-weight: 750; text-transform: uppercase; padding: 8px 10px; text-align: left; white-space: nowrap; }
        .mini-table td { padding: 8px 10px; border-top: 1px solid #f1f5f9; vertical-align: top; }
        .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }

        .refund-box { border: 1px solid #bfdbfe; background: #f8fbff; border-radius: 12px; padding: 16px; }
        .refund-box .form-control, .refund-box .form-select { font-size: 13px; }

        .provider-pre {
            max-height: 360px; overflow: auto;
            background: #0f172a; color: #e2e8f0;
            border-radius: 9px; padding: 14px; font-size: 11.5px;
        }
        .provider-toggle { cursor: pointer; font-weight: 650; color: var(--primary); font-size: 13px; }

        @media (max-width: 768px) {
            .page-container { padding: 14px; }
            .detail-grid { grid-template-columns: 1fr 1fr; }
            .seg-row { grid-template-columns: 1fr 1fr; }
            .toolbar-right .form-control { width: 100%; }
        }
    </style>
</head>

<body>
<div class="page-container">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="bi bi-journal-check text-primary me-2"></i>
                TripJack Bookings
            </h1>
            <p class="subtitle mb-0">Flight and hotel bookings made through the supplier API</p>
        </div>

        <div class="d-flex gap-3 flex-wrap">
            <div class="total-card action" id="actionCard" title="Show bookings that need action">
                <div class="d-flex align-items-center gap-3">
                    <div class="total-icon"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <div class="total-label">Needs action (refund / review)</div>
                        <div class="total-value" id="actionCount">—</div>
                    </div>
                </div>
            </div>
            <div class="total-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="total-icon"><i class="bi bi-ticket-perforated"></i></div>
                    <div>
                        <div class="total-label">Bookings (this filter)</div>
                        <div class="total-value" id="totalBookings">—</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="toolbar">
            <div class="filter-group">
                <button class="filter-btn active" type="button" data-type="ALL"><i class="bi bi-grid me-1"></i> All</button>
                <button class="filter-btn" type="button" data-type="FLIGHT"><i class="bi bi-airplane me-1"></i> Flights</button>
                <button class="filter-btn" type="button" data-type="HOTEL"><i class="bi bi-building me-1"></i> Hotels</button>
            </div>
            <div class="toolbar-right">
                <input class="form-control" id="searchInput" type="search" placeholder="Reference, PNR, supplier ID, account name / email, mobile">
                <select class="form-select" id="statusFilter" style="width: auto;">
                    <option value="">All statuses</option>
                    <option value="ACTION">Needs action</option>
                    <option value="BOOKED">Booked</option>
                    <option value="BOOKING_IN_PROGRESS">Booking in progress</option>
                    <option value="BOOKING_FAILED">Booking failed</option>
                    <option value="INITIATED">Awaiting payment</option>
                    <option value="PAYMENT_NOT_COMPLETED">Payment not completed</option>
                    <option value="PAYMENT_FAILED">Payment failed</option>
                    <option value="REVIEW_FAILED">Fare check failed</option>
                    <option value="REFUNDED">Refunded</option>
                    <option value="CANCELLED">Cancelled</option>
                </select>
                <button type="button" class="refresh-btn" id="refreshBtn"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
            </div>
        </div>

        <div id="loadingState" class="state-box">
            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
            Loading bookings...
        </div>

        <div id="errorState" class="state-box d-none">
            <i class="bi bi-exclamation-circle text-danger"></i>
            <div class="fw-semibold text-dark">Unable to load bookings</div>
            <div id="errorText" class="small my-2">Please try again.</div>
            <button class="btn btn-sm btn-primary" id="retryBtn">Retry</button>
        </div>

        <div id="emptyState" class="state-box d-none">
            <i class="bi bi-inbox"></i>
            <div class="fw-semibold text-dark">No bookings found</div>
            <div class="small">There are no bookings for this filter.</div>
        </div>

        <div class="table-responsive d-none" id="tableWrapper">
            <table class="table booking-table">
                <thead>
                    <tr>
                        <th>Booking Reference</th>
                        <th>Booking Details</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Booking Status</th>
                        <th>Payment</th>
                        <th>Amount</th>
                        <th>PNR / Supplier ID</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody id="bookingTableBody"></tbody>
            </table>
        </div>

        <div class="pagination-area d-none" id="paginationArea">
            <div class="pagination-info" id="paginationInfo"></div>
            <nav aria-label="Bookings pagination">
                <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
            </nav>
        </div>
    </div>
</div>

<!-- Booking Details Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="bookingDetailsTitle">
                        <i class="bi bi-receipt-cutoff text-primary me-2"></i>
                        Booking Details
                    </h5>
                    <div class="small text-secondary mt-1" id="modalReference"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bookingDetailsBody"></div>
            <div class="modal-footer justify-content-between">
                <button class="btn btn-outline-primary btn-sm" id="refreshStatusBtn" type="button">
                    <i class="bi bi-arrow-repeat me-1"></i> Refresh status from supplier
                </button>
                <button class="btn btn-light border btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
(() => {
    'use strict';

    // Same-origin admin endpoints (admin session + permission required)
    const BASE = '/admin/providers/tripjack-bookings';
    const PAGE_LIMIT = 10;

    let currentType = 'ALL';
    let currentStatus = '';
    let currentQuery = '';
    let currentPage = 1;
    let totalPages = 0;
    let bookings = [];
    let requestVersion = 0;
    let openBookingId = null;
    let searchTimer = null;

    const $ = id => document.getElementById(id);
    const modal = new bootstrap.Modal($('bookingDetailsModal'));

    /* ---------------- helpers ---------------- */

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[char]);
    }

    function safeJson(value) {
        try { return JSON.stringify(value, null, 2); } catch { return String(value ?? ''); }
    }

    function date(value, withTime = false) {
        if (!value) return '—';
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return String(value);
        return new Intl.DateTimeFormat('en-IN', {
            day: '2-digit', month: 'short', year: 'numeric',
            ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {})
        }).format(d);
    }

    function time(value) {
        const m = String(value || '').match(/T(\d{2}:\d{2})/);
        return m ? m[1] : '—';
    }

    function money(amount, currency = 'INR') {
        if (amount === null || amount === undefined || amount === '') return '—';
        const n = Number(amount);
        if (!Number.isFinite(n)) return String(amount);
        try {
            return new Intl.NumberFormat('en-IN', { style: 'currency', currency: currency || 'INR', maximumFractionDigits: 2 }).format(n);
        } catch {
            return `${currency} ${n.toFixed(2)}`;
        }
    }

    function normalized(value) {
        return String(value || 'UNKNOWN').trim().toUpperCase().replace(/[\s-]+/g, '_');
    }

    function statusClass(value) {
        const s = normalized(value);
        if (['BOOKED', 'SUCCESS', 'CONFIRMED', 'COMPLETED', 'PAID', 'MANUAL', 'ACTIVE'].includes(s)) return 'success';
        if (s === 'INACTIVE') return 'danger';
        if (['PENDING', 'INITIATED', 'PROCESSING', 'BOOKING_IN_PROGRESS', 'ON_HOLD', 'PARTIALLY_REFUNDED'].includes(s)) return 'warning';
        if (['FAILED', 'BOOKING_FAILED', 'PAYMENT_FAILED', 'REVIEW_FAILED', 'CANCELLED', 'REJECTED', 'PAYMENT_NOT_COMPLETED'].includes(s)) return 'danger';
        if (['REFUNDED'].includes(s)) return 'info';
        return 'neutral';
    }

    function statusBadge(value) {
        return `<span class="badge-custom ${statusClass(value)}">${escapeHtml(normalized(value).replaceAll('_', ' '))}</span>`;
    }

    function typeBadge(type) {
        const t = normalized(type);
        if (t === 'HOTEL') return '<span class="badge-custom type-hotel"><i class="bi bi-building"></i> HOTEL</span>';
        if (t === 'FLIGHT') return '<span class="badge-custom type-flight"><i class="bi bi-airplane"></i> FLIGHT</span>';
        return `<span class="badge-custom type-other">${escapeHtml(t)}</span>`;
    }

    function supplier(booking) {
        const data = booking.booking_data || {};
        return data.tripJack || data.tripjack || {};
    }

    function flightSegments(booking) {
        const data = booking.booking_data || {};
        const details = supplier(booking).bookingDetails;
        const trips = details?.itemInfos?.AIR?.tripInfos || data.review?.tripInfos || [];
        return (Array.isArray(trips) ? trips : []).flatMap(t => t.sI || []);
    }

    function getHotel(booking) {
        const data = booking.booking_data || {};
        const tj = supplier(booking);
        const review = tj.review || {};
        const details = tj.bookingDetails || {};
        const hInfo = details.itemInfos?.HOTEL?.hInfo || details.data?.itemInfos?.HOTEL?.hInfo || {};
        const hotel = data.hotel || {};
        const option = review.option || {};
        const room = option.roomInfo?.[0] || {};
        const bookedRoom = hInfo.ops?.[0]?.ris?.[0] || {};

        return {
            name: hotel.hotelName || review.hotelName || hInfo.name || 'Hotel booking',
            hotelId: hotel.hotelId || review.hotelId || hInfo.id || '',
            address: hotel.address || hInfo.ad?.adr || hInfo.address || '',
            checkIn: data.search?.checkIn || hInfo.checkInDate || '',
            checkOut: data.search?.checkOut || hInfo.checkOutDate || '',
            room: room.name || bookedRoom.rc || bookedRoom.rn || '',
            meal: option.mealBasis || bookedRoom.mb || '',
            rating: hInfo.rt || hInfo.rating || '',
            confirmation: tj.hotelConfirmationNumber || tj.summary?.hotelConfirmationNumber || ''
        };
    }

    // Airline PNR only. Older bookings saved the supplier booking id (TJS…/TJP…)
    // in provider_reference: that is not a PNR.
    function airlinePnr(booking) {
        const data = booking.booking_data || {};
        if (data.pnr) return data.pnr;
        const ref = String(booking.provider_reference || '').trim();
        if (!ref || /^TJ[A-Z]?\d{6,}$/i.test(ref) || ref === String(booking.provider_booking_id || '')) return '';
        return ref;
    }

    function description(booking) {
        const type = normalized(booking.booking_type);
        if (type === 'HOTEL') {
            const h = getHotel(booking);
            return { title: h.name, subtitle: h.checkIn && h.checkOut ? `${date(h.checkIn)} – ${date(h.checkOut)}` : h.room || 'Hotel reservation' };
        }
        if (type === 'FLIGHT') {
            const segs = flightSegments(booking);
            const first = segs[0] || {};
            const last = segs[segs.length - 1] || {};
            const airline = [...new Set(segs.map(s => s.fD?.aI?.name).filter(Boolean))].join(' + ');
            const pax = (booking.booking_data?.passengers || []).length;
            // one "FROM → TO" per journey (round trip / multi city)
            const data = booking.booking_data || {};
            const trips = supplier(booking).bookingDetails?.itemInfos?.AIR?.tripInfos || data.review?.tripInfos || [];
            const journeys = (Array.isArray(trips) ? trips : [])
                .map(t => t.sI || [])
                .filter(s => s.length)
                .map(s => `${s[0].da?.code} → ${s[s.length - 1].aa?.code}`);
            return {
                title: journeys.length ? journeys.join(' · ') : first.da ? `${first.da.code} → ${last.aa?.code}` : 'Flight booking',
                subtitle: [airline, first.dt ? date(first.dt) : '', pax ? `${pax} pax` : ''].filter(Boolean).join(' • ')
            };
        }
        return { title: booking.booking_type || 'Booking', subtitle: '—' };
    }

    function item(label, value, raw = false) {
        const empty = value === null || value === undefined || value === '';
        return `<div class="detail-item">
            <div class="detail-label">${escapeHtml(label)}</div>
            <div class="detail-value">${empty ? '—' : raw ? value : escapeHtml(value)}</div>
        </div>`;
    }

    function section(title, icon, html) {
        return `<section class="detail-section">
            <h6 class="section-heading"><i class="bi ${icon}"></i>${escapeHtml(title)}</h6>
            ${html}
        </section>`;
    }

    async function api(path, options = {}) {
        const response = await fetch(`${BASE}${path}`, {
            credentials: 'same-origin',
            ...options,
            headers: {
                Accept: 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                ...(options.body ? { 'Content-Type': 'application/json' } : {}),
                ...(options.headers || {})
            }
        });
        let result = {};
        try { result = await response.json(); } catch { /* not json */ }
        if (!response.ok || result.success === false) {
            throw new Error(result.message || `Request failed (${response.status})`);
        }
        return result;
    }

    /* ---------------- list ---------------- */

    function showState(state) {
        $('loadingState').classList.toggle('d-none', state !== 'loading');
        $('errorState').classList.toggle('d-none', state !== 'error');
        $('emptyState').classList.toggle('d-none', state !== 'empty');
        $('tableWrapper').classList.toggle('d-none', state !== 'table');
        $('paginationArea').classList.toggle('d-none', state !== 'table');
    }

    async function loadBookings(page = 1) {
        const version = ++requestVersion;
        currentPage = page;
        showState('loading');
        $('pagination').innerHTML = '';

        try {
            const params = new URLSearchParams({ type: currentType, page: String(page), limit: String(PAGE_LIMIT) });
            if (currentStatus) params.set('status', currentStatus);
            if (currentQuery) params.set('q', currentQuery);

            const result = await api(`/data?${params}`);
            if (version !== requestVersion) return;

            bookings = Array.isArray(result.data) ? result.data : [];
            const info = result.pagination || {};
            totalPages = Number(info.totalPages) || 0;

            $('totalBookings').textContent = (Number(info.totalRecords) || 0).toLocaleString('en-IN');
            $('actionCount').textContent = (Number(result.summary?.actionCount) || 0).toLocaleString('en-IN');

            renderRows();
            renderPagination(info);
            showState(bookings.length ? 'table' : 'empty');
        } catch (error) {
            if (version !== requestVersion) return;
            $('errorText').textContent = error.message || 'Please try again.';
            showState('error');
        }
    }

    function rowFlags(b) {
        const data = b.booking_data || {};
        const flags = [];
        const refund = b.refundSummary || {};
        if (data.refundRequired && refund.refundable > 0) flags.push('<span class="badge-custom danger"><i class="bi bi-cash-coin"></i> Refund due</span>');
        if (data.needsManualReview) flags.push('<span class="badge-custom warning"><i class="bi bi-eye"></i> Needs review</span>');
        if (refund.refunded > 0) flags.push(`<span class="badge-custom info">Refunded ${money(refund.refunded)}</span>`);
        return flags.length ? `<div class="chips">${flags.join('')}</div>` : '';
    }

    function renderRows() {
        $('bookingTableBody').innerHTML = bookings.map((b, index) => {
            const d = description(b);
            const data = b.booking_data || {};
            const contact = data.contact || data.primaryGuest || {};
            return `
                <tr>
