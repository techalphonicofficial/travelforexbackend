<div class="tf-page-header">
  <div>
    <h2 class="tf-page-title">Blog Posts</h2>
    <p class="tf-page-sub">Manage your blog content and articles</p>
  </div>
  <div class="d-flex gap-2 flex-wrap justify-content-end">
    <button type="button" class="btn btn-outline-danger" id="deleteSelectedPostsBtn" disabled>
      <i class="bi bi-trash3 me-2"></i> Delete Selected
    </button>
    <a href="/cms/blog/posts/create" class="btn btn-add-primary">
      <i class="bi bi-plus-lg me-2"></i> New Post
    </a>
  </div>
</div>

<div class="mb-3">
  <div class="input-group" style="max-width: 460px;">
    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
    <input type="search" class="form-control border-start-0" id="postSearchInput" placeholder="Search blog posts...">
  </div>
</div>

<div class="tf-table-wrap">
  <table class="tf-table">
    <thead>
      <tr>
        <th style="width: 46px;">
          <input type="checkbox" class="form-check-input" id="selectAllPosts" <%= posts.length ? '' : 'disabled' %>>
        </th>
        <th>Post</th>
        <th>Category</th>
        <th>Status</th>
        <th>Featured</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody id="postsTableBody">
      <% posts.forEach(post => { %>
        <tr id="post-<%= post.id %>" class="post-row">
          <td>
            <input type="checkbox" class="form-check-input post-checkbox" value="<%= post.id %>">
          </td>
          <td>
            <div class="d-flex align-items-center gap-3">
              <% if (post.featured_image) { %>
                <img src="<%= post.featured_image %>" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
              <% } else { %>
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-journal-text text-muted"></i>
                </div>
              <% } %>
              <div>
                <div class="fw-bold"><%= post.title %></div>
                <div class="small text-muted">/blog/<%= post.slug %></div>
              </div>
            </div>
          </td>
          <td>
            <span class="badge bg-light text-dark border"><%= post.category ? post.category.name : 'Uncategorized' %></span>
          </td>
          <td>
            <% const statusClassMap = {
              published: 'bg-success-subtle text-success',
              active: 'bg-success-subtle text-success',
              inactive: 'bg-danger-subtle text-danger',
              draft: 'bg-warning-subtle text-warning'
            }; %>
            <% let statusClass = statusClassMap[post.status] || 'bg-info-subtle text-info'; %>
            <span class="tf-badge <%= statusClass %>">
              <%= post.status.toUpperCase() %>
            </span>
          </td>
          <td>
            <% if (post.is_featured) { %>
              <i class="bi bi-star-fill text-warning"></i>
            <% } else { %>
              <i class="bi bi-star text-muted opacity-50"></i>
            <% } %>
          </td>
          <td class="text-end">
            <div class="d-flex justify-content-end gap-2">
              <a href="/cms/blog/posts/<%= post.id %>/edit" class="btn-icon btn-icon-edit" title="Edit"><i class="bi bi-pencil"></i></a>
              <button onclick="duplicatePost(<%= post.id %>)" class="btn-icon btn-icon-view" title="Duplicate"><i class="bi bi-copy"></i></button>
              <button onclick="deletePost(<%= post.id %>)" class="btn-icon btn-icon-del" title="Delete"><i class="bi bi-trash"></i></button>
            </div>
          </td>
        </tr>
      <% }) %>
      <tr id="noPostsRow" style="<%= posts.length ? 'display:none;' : '' %>">
        <td colspan="6" class="text-center text-muted py-4">No blog posts found.</td>
      </tr>
    </tbody>
  </table>
</div>

<script>
  const searchInput = document.getElementById('postSearchInput');
  const noPostsRow = document.getElementById('noPostsRow');
  const selectAllPosts = document.getElementById('selectAllPosts');
  const deleteSelectedPostsBtn = document.getElementById('deleteSelectedPostsBtn');

  function getPostRows() {
    return Array.from(document.querySelectorAll('.post-row'));
  }

  function getVisiblePostRows() {
    return getPostRows().filter(row => row.style.display !== 'none');
  }

  function getSelectedCheckboxes() {
    return Array.from(document.querySelectorAll('.post-checkbox:checked'));
  }

  function updateSelectionState() {
    const rows = getPostRows();
    const visibleRows = getVisiblePostRows();
    const visibleCheckboxes = visibleRows.map(row => row.querySelector('.post-checkbox'));
    const selectedVisibleCount = visibleCheckboxes.filter(checkbox => checkbox.checked).length;
    const selectedCount = getSelectedCheckboxes().length;

    selectAllPosts.disabled = rows.length === 0 || visibleRows.length === 0;
    selectAllPosts.checked = visibleCheckboxes.length > 0 && selectedVisibleCount === visibleCheckboxes.length;
    selectAllPosts.indeterminate = selectedVisibleCount > 0 && selectedVisibleCount < visibleCheckboxes.length;
    deleteSelectedPostsBtn.disabled = selectedCount === 0;
    deleteSelectedPostsBtn.innerHTML = selectedCount
      ? `<i class="bi bi-trash3 me-2"></i> Delete Selected (${selectedCount})`
      : '<i class="bi bi-trash3 me-2"></i> Delete Selected';
  }

  function updateEmptyState() {
    const rows = getPostRows();
    const visibleRows = getVisiblePostRows();
    noPostsRow.style.display = visibleRows.length ? 'none' : '';
    updateSelectionState();
  }

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    getPostRows().forEach(row => {
      row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
    });
    updateEmptyState();
  });

  selectAllPosts.addEventListener('change', () => {
    getVisiblePostRows().forEach(row => {
      row.querySelector('.post-checkbox').checked = selectAllPosts.checked;
    });
    updateSelectionState();
  });

  document.addEventListener('change', event => {
    if (!event.target.classList.contains('post-checkbox')) return;
    updateSelectionState();
  });

  async function deletePost(id) {
    if (!confirm('Are you sure you want to delete this post?')) return;
    const res = await fetch(`/cms/blog/posts/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      document.getElementById(`post-${id}`).remove();
      updateEmptyState();
    } else {
      alert(data.message || 'Unable to delete post.');
    }
  }

  deleteSelectedPostsBtn.addEventListener('click', async () => {
    const selectedIds = getSelectedCheckboxes().map(checkbox => checkbox.value);
    if (!selectedIds.length) return;
    if (!confirm(`Are you sure you want to delete ${selectedIds.length} selected blog post(s)? This cannot be undone.`)) return;
    deleteSelectedPostsBtn.disabled = true;
    deleteSelectedPostsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Deleting...';

    try {
      await Promise.all(selectedIds.map(async id => {
        const res = await fetch(`/cms/blog/posts/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!data.success) throw new Error(data.message || `Unable to delete post ${id}.`);
        document.getElementById(`post-${id}`)?.remove();
      }));
      updateEmptyState();
    } catch (err) {
      alert(err.message);
      updateSelectionState();
    } finally {
      updateSelectionState();
    }
  });

  async function duplicatePost(id) {
    if (!confirm('Are you sure you want to duplicate this blog post?')) return;
    try {
      const res = await fetch(`/cms/blog/posts/${id}/duplicate`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        location.reload();
      } else {
        alert('Error: ' + (data.message || 'Failed to duplicate blog post'));
      }
    } catch (err) {
      alert('Failed to duplicate blog post: ' + err.message);
    }
  }
</script>
